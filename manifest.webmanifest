{
  "id": "./",
  "name": "BOARD//BOX",
  "short_name": "BOARD//BOX",
  "description": "One app. Every game. Chess, checkers, Connect 4, 2048 and more — plus daily challenges.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Daily puzzle", "url": "./#/daily/puzzle", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chess", "url": "./#/play/chess", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Profile", "url": "./#/profile", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
